<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#E8F5E9"/>
            <corners android:radius="28dp"/>
            <stroke
                android:width="2dp"
                android:color="#2ECC71"/>
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape>
            <solid android:color="#EEEEEE"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>

</selector>